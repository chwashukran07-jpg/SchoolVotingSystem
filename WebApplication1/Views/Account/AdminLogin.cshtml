@model VotingSystem.Models.LoginViewModel

@{
    ViewBag.Title = "Admin Login";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-dark">
            <div class="card-header bg-dark text-white">Election Admin</div>
            <div class="card-body">
                <h2 class="card-title h4">Admin Login</h2>
                <p class="text-muted">For election officials managing elections and the voter list.</p>

                @using (Html.BeginForm("AdminLogin", "Account", new { ReturnUrl = ViewBag.ReturnUrl }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        <label class="form-label" for="UserName">Username</label>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.UserName, "Username is required.", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Log in as admin</button>
                }

                <hr />
                <p class="mb-0 small">Are you a student? @Html.ActionLink("Student login", "Login")</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

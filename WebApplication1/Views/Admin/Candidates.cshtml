@model VotingSystem.Models.Election

@{
    ViewBag.Title = "Candidates - " + Model.Title;
}

<h2>Candidates for @Model.Title</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Party</th>
    </tr>
@foreach (var c in Model.Candidates)
{
    <tr>
        <td>@c.Name</td>
        <td>@c.Party</td>
    </tr>
}
</table>

<h3>Add Candidate</h3>

@using (Html.BeginForm("AddCandidate", "Admin"))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("electionId", Model.Id)

    <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" class="form-control" required="required" />
    </div>

    <div class="form-group">
        <label>Party (optional)</label>
        <input type="text" name="party" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add Candidate</button>
}

@Html.ActionLink("Back to list", "Index")

@model IEnumerable<VotingSystem.Models.Election>

@{
    ViewBag.Title = "Open Elections";
    var votedIds = (HashSet<int>)ViewBag.VotedIds;
}

<h2>Elections Open for Voting</h2>

@if (!Model.Any())
{
    <p>There are no elections open for voting right now.</p>
}
else
{
    <ul class="list-group">
    @foreach (var e in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
                <strong>@e.Title</strong><br />
                <small class="text-muted">Closes @e.EndDate.ToString("g")</small>
            </span>
            @if (votedIds.Contains(e.Id))
            {
                <span class="badge bg-success">Voted &#10003;</span>
            }
            else
            {
                @Html.ActionLink("Vote", "Cast", new { id = e.Id }, new { @class = "btn btn-sm btn-primary" })
            }
        </li>
    }
    </ul>
}
